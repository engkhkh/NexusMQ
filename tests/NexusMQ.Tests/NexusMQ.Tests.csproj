<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3: a test project is a program (it can also run on its own: dotnet run, or the built .exe). -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3" Version="3.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test classes run one after another: the integration tests start live servers and Raft clusters with tight timings. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NexusMQ.Core\NexusMQ.Core.csproj" />
    <ProjectReference Include="..\..\src\NexusMQ.AspNetCore\NexusMQ.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\NexusMQ.Client\NexusMQ.Client.csproj" />
  </ItemGroup>

</Project>