<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3: a test project is a program (it can also run on its own: dotnet run, or the built .exe).
         xUnit 4 runs on Microsoft Testing Platform v2; global.json tells `dotnet test` (.NET 10 SDK) to use it, and Visual
         Studio 2026 runs it natively, so the VSTest packages (Microsoft.NET.Test.Sdk, xunit.runner.visualstudio,
         coverlet.collector) are no longer needed. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test classes run one after another: the integration tests start live servers and Raft clusters with tight timings. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NexusMQ.Core\NexusMQ.Core.csproj" />
    <ProjectReference Include="..\..\src\NexusMQ.AspNetCore\NexusMQ.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\NexusMQ.Client\NexusMQ.Client.csproj" />
  </ItemGroup>

</Project>